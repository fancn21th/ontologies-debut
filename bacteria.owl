<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://example.org/ontologies/bacteria.owl"
         xmlns="https://example.org/ontologies/bacteria.owl#">

<owl:Ontology rdf:about="https://example.org/ontologies/bacteria.owl"/>

<owl:ObjectProperty rdf:about="#has_shape">
  <rdfs:domain rdf:resource="#Bacterium"/>
  <rdfs:range rdf:resource="#Shape"/>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#has_grouping">
  <rdfs:domain rdf:resource="#Bacterium"/>
  <rdfs:range rdf:resource="#Grouping"/>
</owl:ObjectProperty>

<owl:DatatypeProperty rdf:about="#gram_positive">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Bacterium"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
</owl:DatatypeProperty>

<owl:DatatypeProperty rdf:about="#nb_colonies">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:domain rdf:resource="#Bacterium"/>
  <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
</owl:DatatypeProperty>

<owl:Class rdf:about="#Bacterium">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has_shape"/>
      <owl:onClass rdf:resource="#Shape"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Coccus">
  <rdfs:subClassOf rdf:resource="#Bacterium"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Bacterium"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#has_shape"/>
          <owl:someValuesFrom rdf:resource="#Round"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Bacillus">
  <rdfs:subClassOf rdf:resource="#Bacterium"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Bacterium"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#has_shape"/>
          <owl:someValuesFrom rdf:resource="#Elongated"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
</owl:Class>

<owl:Class rdf:about="#Streptococcus">
  <rdfs:subClassOf rdf:resource="#Bacterium"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#gram_positive"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has_shape"/>
      <owl:someValuesFrom rdf:resource="#Round"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has_grouping"/>
      <owl:someValuesFrom rdf:resource="#InChain"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:complementOf>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#has_grouping"/>
          <owl:someValuesFrom rdf:resource="#Isolated"/>
        </owl:Restriction>
      </owl:complementOf>
    </owl:Class>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Staphylococcus">
  <rdfs:subClassOf rdf:resource="#Bacterium"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#gram_positive"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has_shape"/>
      <owl:someValuesFrom rdf:resource="#Round"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has_grouping"/>
      <owl:someValuesFrom rdf:resource="#InCluster"/>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Pseudomonas">
  <rdfs:subClassOf rdf:resource="#Bacterium"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has_shape"/>
      <owl:someValuesFrom rdf:resource="#Elongated"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has_grouping"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#Isolated"/>
            <rdf:Description rdf:about="#InPair"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#gram_positive"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Salmonella">
  <rdfs:subClassOf rdf:resource="#Bacterium"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has_shape"/>
      <owl:someValuesFrom rdf:resource="#Elongated"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#has_grouping"/>
      <owl:someValuesFrom>
        <owl:Class>
          <owl:unionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="#Isolated"/>
            <rdf:Description rdf:about="#InPair"/>
          </owl:unionOf>
        </owl:Class>
      </owl:someValuesFrom>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#gram_positive"/>
      <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</owl:hasValue>
    </owl:Restriction>
  </rdfs:subClassOf>
</owl:Class>

<owl:Class rdf:about="#Shape">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Round">
  <rdfs:subClassOf rdf:resource="#Shape"/>
  <owl:disjointWith rdf:resource="#Elongated"/>
</owl:Class>

<owl:Class rdf:about="#Elongated">
  <rdfs:subClassOf rdf:resource="#Shape"/>
</owl:Class>

<owl:Class rdf:about="#Grouping">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
</owl:Class>

<owl:Class rdf:about="#Isolated">
  <rdfs:subClassOf rdf:resource="#Grouping"/>
</owl:Class>

<owl:Class rdf:about="#InPair">
  <rdfs:subClassOf rdf:resource="#Grouping"/>
</owl:Class>

<owl:Class rdf:about="#InCluster">
  <rdfs:subClassOf rdf:resource="#Grouping"/>
</owl:Class>

<owl:Class rdf:about="#InChain">
  <rdfs:subClassOf rdf:resource="#Grouping"/>
</owl:Class>

<owl:Class rdf:about="#InSmallChain">
  <rdfs:subClassOf rdf:resource="#InChain"/>
</owl:Class>

<owl:Class rdf:about="#InLongChain">
  <rdfs:subClassOf rdf:resource="#InChain"/>
</owl:Class>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Bacterium"/>
    <rdf:Description rdf:about="#Shape"/>
    <rdf:Description rdf:about="#Grouping"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
